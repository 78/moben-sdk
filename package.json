{
  "name": "@moben-ai/app-sdk",
  "version": "0.7.0",
  "description": "Build Moben Markdown apps and debug connected Moben devices over USB.",
  "keywords": [
    "moben",
    "e-ink",
    "remote-app",
    "sdk"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "moben": "dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "README.md",
    "docs",
    "REMOTE_APPS.md",
    "examples/machine/app.ts",
    "examples/machine/package.json",
    "examples/machine/.env.example",
    "examples/machine/AGENTS.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "sync": "node scripts/sync-core.mjs",
    "build": "node scripts/sync-core.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/sync-core.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/sync-core.mjs && tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/78/moben-sdk.git"
  },
  "homepage": "https://github.com/78/moben-sdk#readme",
  "bugs": {
    "url": "https://github.com/78/moben-sdk/issues"
  }
}
